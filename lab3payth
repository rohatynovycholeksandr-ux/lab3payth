def count_unique(a):
    return len(set(a))


def build_vector(A):
    return [count_unique(row) for row in A]


def task1():
    n = int(input("Введіть n (до 20): "))
    A = [list(map(int, input().split())) for _ in range(n)]
    B = build_vector(A)

    print("Вектор B:")
    for i in range(0, n, 10):
        print(*B[i:i + 10])


def task2():
    heights = []

    for i in range(20):
        gender = input("Стать (ч/ж): ").lower()
        height = float(input("Зріст у см: "))
        if gender == "ч":
            heights.append(height)

    if heights:
        print("Середній зріст чоловіків:", sum(heights) / len(heights))
    else:
        print("Чоловіків немає")

