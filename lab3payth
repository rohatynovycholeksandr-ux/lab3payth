def task3():
    N, K = map(int, input("Введіть N і K: ").split())
    strikes = set()

    for i in range(K):
        a, b = map(int, input("Введіть a і b: ").split())
        for day in range(a, N + 1, b):
            if day % 7 not in (6, 0):
                strikes.add(day)

    print("Кількість страйків:", len(strikes))


while True:
    print("\n1 - Матриця")
    print("2 - Середній зріст чоловіків")
    print("3 - Політичні страйки")
    print("0 - Вихід")

    choice = input("Ваш вибір: ")

    if choice == "1":
        task1()
    elif choice == "2":
        task2()
    elif choice == "3":
        task3()
    elif choice == "0":
        break
    else:
        print("Неправильний вибір")
